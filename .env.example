# Copie para .env e ajuste. NUNCA versione o .env.

# --- API ---------------------------------------------------------------
# Porta dentro do container.
PORT=3000
# Porta publicada na VPS (fica em 127.0.0.1; use um proxy reverso com HTTPS).
HOST_PORT=3000
HOST=0.0.0.0
# Obrigatoria. Gere com: openssl rand -hex 24
API_KEY=troque-esta-chave-por-uma-aleatoria
LOG_LEVEL=info

# --- Sessao do WhatsApp ------------------------------------------------
SESSION_ID=emerson
SESSION_DATA_PATH=./data/sessions
# Definido pela imagem Docker; fora do Docker, deixe vazio para o puppeteer
# baixar o proprio Chromium.
CHROME_EXECUTABLE_PATH=/usr/bin/chromium
# Licenca do OpenWA (opcional, so para recursos pagos).
WA_LICENSE_KEY=
AUTH_TIMEOUT_SEC=90
SESSION_MAX_RESTARTS=5
SESSION_RESTART_DELAY_MS=10000

# --- Webhook de mensagens recebidas ------------------------------------
# Deixe vazio para desativar.
WEBHOOK_URL=
# Se preenchido, cada POST vai assinado no header X-OpenWA-Signature.
WEBHOOK_SECRET=
WEBHOOK_EVENTS=message,ack,state,call
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_IGNORE_FROM_ME=true
WEBHOOK_IGNORE_GROUPS=false

# --- Envio -------------------------------------------------------------
# Intervalo aleatorio entre mensagens (anti-bloqueio).
SEND_MIN_DELAY_MS=1500
SEND_MAX_DELAY_MS=4000
SIMULATE_TYPING=true
DEFAULT_COUNTRY_CODE=55
CHECK_NUMBER_BEFORE_SEND=true
MAX_MEDIA_MB=16
MEDIA_DOWNLOAD_TIMEOUT_MS=30000
