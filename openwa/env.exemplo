# ===========================================
# OpenWA — configuracao com MCP habilitado
# ===========================================
# Copie este arquivo para dentro do clone do OpenWA como `.env`:
#     cp openwa/env.exemplo OpenWA/.env
#
# Referencia completa de variaveis: OpenWA/.env.example

# --- Servidor ---
PORT=2785
NODE_ENV=production

# --- Banco de dados (SQLite: nao precisa de servico externo) ---
DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
DATABASE_SYNCHRONIZE=true

# --- Engine do WhatsApp ---
# whatsapp-web.js = menor risco de ban, ~300-500 MB de RAM por sessao
# baileys         = mais leve (~30-80 MB), porem mais facil de ser detectado
ENGINE_TYPE=whatsapp-web.js
PUPPETEER_HEADLESS=true

# --- Sessoes ---
# Nao iniciar sessoes automaticamente no boot ate voce validar o setup
AUTO_START_SESSIONS=false

# ===========================================
# MCP (Model Context Protocol)
# ===========================================
# Monta um servidor MCP em POST /mcp, na mesma porta do servidor (2785).
# Documentacao: OpenWA/docs/24-mcp-integration.md
MCP_ENABLED=true

# ATENCAO: o modo read-only e o PADRAO.
#   MCP_READONLY=true  (ou ausente) -> so ferramentas de leitura:
#                       listar sessoes, ler chats, contatos, grupos.
#                       O agente NAO envia mensagem.
#   MCP_READONLY=false -> libera as ferramentas de escrita (enviar mensagem etc).
#
# Comece com true. Só mude para false quando tiver validado o restante.
MCP_READONLY=true

# Limite de chamadas de ferramenta por chave, por janela (padrao 60 / 60s)
MCP_RATE_LIMIT_MAX=60
MCP_RATE_LIMIT_WINDOW_MS=60000

# Limite pre-autenticacao por IP no /mcp (padrao 120 / 60s)
MCP_IP_RATE_LIMIT_MAX=120
MCP_IP_RATE_LIMIT_WINDOW_MS=60000
